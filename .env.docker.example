# Copy this file to `.env.docker` to customise the Docker dev environment.
# UID/GID help avoid root-owned files on the host when using bind mounts.
HOST_UID=1000
HOST_GID=1000

# Backend configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/lora
REDIS_URL=redis://redis:6379/0
FRONTEND_URL=http://frontend:5173
API_KEY=dev-token

# SDNext connection. Leave empty to disable generation.
# Host install (start SDNext with --listen): http://host.docker.internal:7860
# Bundled container (`make dev-ml`):        http://sdnext:7860
SDNEXT_BASE_URL=

# Host directory mounted as the LoRA library (defaults to ./loras).
# Point it at SDNext's Lora folder so both services see the same files.
# LORA_HOST_DIR=/path/to/sdnext/models/Lora

# Host port for PostgreSQL; change it if 5432 is already in use.
DB_HOST_PORT=5432

# Frontend configuration
VITE_BACKEND_URL=http://api:8000
VITE_BACKEND_API_KEY=dev-token

# Install the optional recommendation/ML stack (PyTorch ROCm, several GB) into the api image.
# Rebuild after changing: make dev
INSTALL_ML=false
